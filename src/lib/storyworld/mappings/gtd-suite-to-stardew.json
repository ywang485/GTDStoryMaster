{
  "mapping_name": "GTD Suite to Stardew Valley",
  "description": "Unified multi-tool mapping: pomodoro timer sessions appear as growing crops that water and mature with each work session; the entire todo list appears as a single billboard whose content reflects all task statuses.",
  "version": "2.1.0",
  "tools": ["todo-list", "pomodoro-timer"],
  "storyworld": "stardew-valley-world-v1",
  "mappings": {
    "object_mappings": [
      {
        "tool": "pomodoro-timer",
        "source": "sessions",
        "target": "crops",
        "initial_state": []
      },
      {
        "tool": "todo-list",
        "source": "todolist",
        "target": "billboard",
        "initial_state": { "content": "", "position": { "x": 650, "y": 100 } }
      }
    ],
    "action_mappings": [
      {
        "tool": "pomodoro-timer",
        "source_action": "start",
        "type": "toolAction",
        "condition": { "param": "type", "equals": "work" },
        "target_action": "water",
        "target_params": []
      },
      {
        "tool": "pomodoro-timer",
        "source_action": "tick",
        "type": "toolAction",
        "target_action": "grow",
        "target_params": [],
        "progress_to_stage": {
          "0": 0,
          "1": 25,
          "2": 50,
          "3": 75,
          "4": 100
        }
      },
      {
        "tool": "pomodoro-timer",
        "source_action": "complete",
        "type": "toolAction",
        "target_action": "mature",
        "target_params": []
      },
      {
        "tool": "pomodoro-timer",
        "source_action": "setStatus",
        "type": "toolAction",
        "condition": { "param": "status", "equals": "cancelled" },
        "target_action": "wilt",
        "target_params": []
      },
      {
        "tool": "pomodoro-timer",
        "source_action": "pause",
        "type": "toolAction",
        "target_action": "water",
        "target_params": []
      },
      {
        "tool": "pomodoro-timer",
        "source_action": "resume",
        "type": "toolAction",
        "target_action": "water",
        "target_params": []
      },
      {
        "tool": "todo-list",
        "source_action": "refresh",
        "type": "toolAction",
        "target_action": "update_content",
        "target_params": [{ "source": "content", "target": "content" }]
      },
      {
        "source_action": "clickObject",
        "type": "UIAction",
        "target_action": "harvest",
        "target_params": []
      }
    ],
    "metadata_mapping": [
      {
        "tool": "pomodoro-timer",
        "source_field": "id",
        "target_field": "id",
        "transform": "slugify"
      },
      {
        "tool": "pomodoro-timer",
        "target_field": "label",
        "transform": "template",
        "format": "{taskTitle} {remaining}",
        "fields": {
          "taskTitle": {
            "source_fields": ["associatedTaskTitle", "type"],
            "transform": "capitalize"
          },
          "remaining": {
            "source_fields": ["remainingSeconds"],
            "transform": "format_time"
          }
        }
      }
    ]
  }
}
