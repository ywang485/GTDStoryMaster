{
  "mapping_name": "TodoList to Stardew Valley",
  "description": "Maps todo list items to crops in Stardew Valley storyworld. Tasks are visualized as crops that grow as you make progress.",
  "version": "1.0.0",
  "tool": "todo-list",
  "storyworld": "stardew-valley-world-v1",
  "mappings": {
    "object_mapping": {
      "source": "tasks",
      "target": "crops"},
    "state_mapping": {
      "rules": [
        {
          "task_state": "pending",
          "crop_state": {
            "growthStage": 0,
            "watered": false
          }
        },
        {
          "task_state": "in_progress",
          "crop_state": {
            "growthStage": 2,
            "watered": true
          }
        },
        {
          "task_state": "completed",
          "crop_state": {
            "growthStage": 4,
            "watered": true
          }
        }
      ]
    },
    "metadata_mapping": {
      "description": "Maps task metadata to crop properties",
      "rules": [
        {
          "task_field": "content",
          "crop_field": "id",
          "transform": "slugify"
        },
        {
          "task_field": "content",
          "crop_field": "label",
          "transform": "truncate",
          "max_length": 30
        },
        {
          "task_field": "activeForm",
          "crop_field": "description"
        }
      ]
    }
  }
}
